# TLS (automatic, via Let's Encrypt) and the security headers from spec §18.15, set at the
# edge as the original design intends — Spring Security (SecurityConfig.java) sets the same
# ones again at the app layer, so bypassing either one still leaves the other in place.
#
# {$DOMAIN} and {$ADMIN_EMAIL} come from the environment Caddy runs in (systemd EnvironmentFile
# or a shell export before `docker compose up` — see the deploy runbook in BACKEND_CONTEXT.md).
{
	email {$ADMIN_EMAIL}
}

{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		-Server
	}

	reverse_proxy app:8080

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# Grafana and Prometheus are deliberately not routed here — they're on `expose`, not `ports`,
# in docker-compose.prod.yml, so nothing outside the compose network can reach them at all by
# default (spec §12's dashboards are an operator tool, not a public one). To view them from
# outside, uncomment a block like this and put a real password behind it — never serve
# Grafana on the open internet with only its own login:
#
# grafana.{$DOMAIN} {
# 	basicauth {
# 		admin {$GRAFANA_BASICAUTH_HASH}
# 	}
# 	reverse_proxy grafana:3000
# }
