# ── Database (Supabase in the deployed profile) ──────────────
# Deployed: use the Supavisor *transaction mode* connection string, port 6543.
CTMS_DB_URL=jdbc:postgresql://localhost:5432/ctms
CTMS_DB_POOL_MAX=10

# Two roles, and they must not be the same one (§7.7).
#   owner  — runs migrations; creates tables, policies and the app role
#   app    — serves requests; owns nothing, so RLS policies actually bind
# Pointing the application at the owner disables every policy silently; the application
# refuses to start if it detects a superuser or BYPASSRLS connection.
CTMS_DB_OWNER_USER=ctms
CTMS_DB_OWNER_PASSWORD=ctms
CTMS_DB_APP_USER=ctms_app
CTMS_DB_APP_PASSWORD=ctms_app

# ── Redis (co-located on the VM; Upstash is the fallback profile) ──
CTMS_REDIS_HOST=localhost
CTMS_REDIS_PORT=6379
CTMS_REDIS_PASSWORD=

# ── Authentication (B2) ──────────────────────────────────────
CTMS_JWT_SECRET=change-me-32-bytes-minimum-in-every-real-environment
CTMS_JWT_ACCESS_TTL_SECONDS=900
CTMS_JWT_REFRESH_TTL_SECONDS=604800

# ── Cloudinary (B6c) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Malware scanning (B6c) ───────────────────────────────────
CTMS_CLAMAV_HOST=localhost
CTMS_CLAMAV_PORT=3310

# ── Application ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
CTMS_CORS_ALLOWED_ORIGIN=http://localhost:3000
