# ── Database (Supabase in the deployed profile) ──────────────
# Local dev: the values below match docker-compose.yml's defaults.
# Deployed (docker-compose.prod.yml, spring.profiles.active=oracle): use the Supavisor
# *transaction mode* connection string, port 6543 — the oracle profile appends
# ?prepareThreshold=0&sslmode=require itself, don't repeat that here.
CTMS_DB_URL=jdbc:postgresql://localhost:5432/ctms
CTMS_DB_POOL_MAX=10

# Local dev: two roles, and they must not be the same one (§7.7).
#   owner  — runs migrations; creates tables, policies and the app role
#   app    — serves requests; owns nothing, so RLS policies actually bind
# Pointing the application at the owner disables every policy silently; the application
# refuses to start if it detects a superuser or BYPASSRLS connection.
CTMS_DB_OWNER_USER=ctms
CTMS_DB_OWNER_PASSWORD=ctms
CTMS_DB_APP_USER=ctms_app
CTMS_DB_APP_PASSWORD=cTms_4pp_S3cure!P@ssw0rd2026

# Deployed profile only (application-oracle.yml reads these instead of the two pairs above —
# Supabase gives one connection identity, not owner/app separately; see BACKEND_CONTEXT.md
# §15 open item on whether Supabase can grant the separate roles §6.3 wants).
CTMS_DB_USER=REPLACE
CTMS_DB_PASSWORD=REPLACE

# ── Redis (co-located on the VM; Upstash is the fallback profile) ──
# Not currently wired to anything the app reads — B8 decided against building the Redis L2
# cache at single-instance scale (BACKEND_CONTEXT.md §12), and rate limiting (§18.10, B9) is
# Bucket4j in-memory for the same reason. Left here as the documented fallback profile the
# design doc (§9.1) describes, not because anything currently connects to it.
CTMS_REDIS_HOST=localhost
CTMS_REDIS_PORT=6379
CTMS_REDIS_PASSWORD=

# ── Authentication (B2) ──────────────────────────────────────
# 256-bit random value, independent of any other secret in this file. Generate with:
#   openssl rand -base64 32
CTMS_JWT_SECRET=change-me-32-bytes-minimum-in-every-real-environment
CTMS_JWT_ACCESS_TTL_SECONDS=900
CTMS_JWT_REFRESH_TTL_SECONDS=604800

# ── Cloudinary (B6c) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Malware scanning (B6c) ───────────────────────────────────
CTMS_CLAMAV_HOST=localhost
CTMS_CLAMAV_PORT=3310

# ── Application ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# Comma-separated exact origins allowed to call the API from a browser. Leave EMPTY when the
# frontend is served from the same site as the API. '*' is rejected at startup — the API
# authenticates by cookie, and a credentialed response cannot carry a wildcard origin.
CTMS_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Lax | Strict | None. Must be None whenever the frontend is on a different site than the API
# (e.g. a localhost:3000 dev server against the deployed API) — a Lax cookie is not sent on a
# cross-site fetch, so every request would arrive anonymous and come back 401. Only set None
# together with an explicit CTMS_CORS_ALLOWED_ORIGINS list.
CTMS_COOKIE_SAME_SITE=None

# ── Keep-alives (B9) ─────────────────────────────────────────
# Optional — a dead-man's-switch URL (e.g. https://hc-ping.com/<uuid> from healthchecks.io).
# Leave blank until that account exists; the health-ping job no-ops on an empty value.
CTMS_OPS_HEALTHPINGURL=

# ── Deployment only — docker-compose.prod.yml / Caddy (B9) ───
# gitleaks (CI) fails the build on anything that looks like a real credential committed by
# mistake — this file is exactly what it should NOT match, so every value below stays a
# placeholder here too.
GRAFANA_ADMIN_PASSWORD=REPLACE
# A real domain you control (for automatic Let's Encrypt TLS) and an email Let's Encrypt can
# reach about certificate issues.
DOMAIN=REPLACE.example.com
ADMIN_EMAIL=REPLACE@example.com
